{
    "name": "instadrop/courier-backend",
    "type": "project",
    "description": "InstaDrop Same-Day Courier Services - Laravel Backend & Admin Panel",
    "keywords": [
        "laravel",
        "courier",
        "admin-panel",
        "api",
        "instadrop"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ezyang/htmlpurifier": "^4.18",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
