APP_NAME="InstaDrop Courier Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/London
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instadrop_courier
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# WhatsApp Cloud API Integration Settings
WHATSAPP_ENABLED=true
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1349924141534825
WHATSAPP_BUSINESS_ACCOUNT_ID=1391593043055339
WHATSAPP_ADMIN_NUMBER=447852502775
WHATSAPP_ORDER_TEMPLATE=new_order_admin_alert
WHATSAPP_INQUIRY_TEMPLATE=new_inquiry_admin_alert
WHATSAPP_PAYMENT_TEMPLATE=payment_received_admin_alert
WHATSAPP_TEMPLATE_LANGUAGE=en


# Stripe Payment Gateway Credentials
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Mail Server Credentials
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
